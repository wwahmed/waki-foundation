{
  "name": "waki-themes-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Theme Studio. Vite + React + TypeScript + Tailwind. Browse, preview, edit, create themes from the waki-themes bundle. Deployed to GitHub Pages.",
  "scripts": {
    "prebundle": "node ../scripts/build-bundle.mjs",
    "sync-bundle": "node scripts/sync-bundle.mjs",
    "dev": "npm run sync-bundle && vite",
    "build": "npm run sync-bundle && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
